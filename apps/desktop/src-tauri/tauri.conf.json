{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "IR Desktop",
  "version": "0.1.0",
  "identifier": "vn.irdesktop.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IR Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/128x128.png"],
    "resources": {
      "../../../packaging/windows/dist/engine": "engine",
      "../../../packaging/windows/dist/pgsql": "pgsql"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
