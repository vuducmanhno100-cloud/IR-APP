{
  "name": "ir-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../../contracts/openapi.yaml -o src/api/schema.d.ts",
    "mock": "prism mock -p 4010 ../../contracts/openapi.yaml",
    "contract:proxy": "prism proxy -p 4011 --errors ../../contracts/openapi.yaml http://127.0.0.1:8765",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-shell": "~2.6.0",
    "@xyflow/react": "~12.12.0",
    "elkjs": "~0.12.1",
    "openapi-fetch": "~0.17.0",
    "react": "~19.3.1",
    "react-dom": "~19.3.1"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "~5.16.0",
    "@tauri-apps/cli": "~2.12.4",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.1.2",
    "openapi-typescript": "~7.13.0",
    "typescript": "~5.9.3",
    "vite": "~8.3.5"
  }
}
